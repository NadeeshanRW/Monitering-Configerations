{
  "kind": "Panel",
  "spec": {
    "id": 1,
    "title": "Metric query",
    "description": "",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "loki",
                "datasource": {
                  "name": "afywt2p13yadce"
                },
                "spec": {
                  "expr": "sum(count_over_time({instance=~\"home_workstation|monitoring_server\"}      [$__auto])) by (detected_level)",
                  "legendFormat": "{{detected_level}}"
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [],
        "queryOptions": {
          "maxDataPoints": 500,
          "interval": "2s"
        }
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "timeseries",
      "version": "13.2.2",
      "spec": {
        "options": {
          "tooltip": {
            "mode": "single",
            "sort": "none",
            "hideZeros": false
          },
          "legend": {
            "showLegend": true,
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [
              "sum"
            ]
          },
          "annotations": {
            "multiLane": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "bars",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "barWidthFactor": 0.6,
              "lineWidth": 0,
              "fillOpacity": 100,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "auto",
              "showValues": false,
              "pointSize": 0,
              "stacking": {
                "mode": "normal",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "",
              "axisColorMode": "text",
              "axisBorderShow": false,
              "scaleDistribution": {
                "type": "linear"
              },
              "axisCenteredZero": false,
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "thresholdsStyle": {
                "mode": "off"
              },
              "axisSoftMin": 0
            },
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 80,
                  "color": "red"
                }
              ]
            },
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byRegexp",
                "options": "/^(info|information)$/i"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "semi-dark-blue",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byRegexp",
                "options": "/^debug$/i"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#9e9e9e",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byRegexp",
                "options": "/^(warn|warning)$/i"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "semi-dark-orange",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byRegexp",
                "options": "/^(error|errors)$/i"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "semi-dark-red",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byRegexp",
                "options": "/^(crit|critical|fatal|severe)$/i"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "semi-dark-purple",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byRegexp",
                "options": "/^trace$/i"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#6ED0E0",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byRegexp",
                "options": "/^(logs|unknown)$/i"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#8e8e8e",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "__systemRef": "hideSeriesFrom",
              "matcher": {
                "id": "byNames",
                "options": {
                  "mode": "exclude",
                  "names": [
                    "warn"
                  ],
                  "prefix": "All except:",
                  "readOnly": true
                }
              },
              "properties": [
                {
                  "id": "custom.hideFrom",
                  "value": {
                    "legend": false,
                    "tooltip": true,
                    "viz": true
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}