{
  "kind": "Panel",
  "spec": {
    "id": 4,
    "title": "VM Resource Utilization",
    "description": "",
    "links": [],
    "transparent": true,
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "prometheus",
                "datasource": {
                  "name": "cfywtrivkf0g0f"
                },
                "spec": {
                  "editorMode": "code",
                  "expr": "sum by (instance) (up{platform=~\"vm|cloud_vm\"})",
                  "format": "table",
                  "instant": true,
                  "legendFormat": "__auto",
                  "range": false
                }
              },
              "refId": "Status",
              "hidden": false
            }
          },
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "prometheus",
                "datasource": {
                  "name": "cfywtrivkf0g0f"
                },
                "spec": {
                  "editorMode": "code",
                  "expr": "((sum by(instance) (node_memory_MemTotal_bytes) - sum by(instance) (node_memory_MemAvailable_bytes)) / sum by(instance) (node_memory_MemTotal_bytes)) * 100",
                  "format": "table",
                  "instant": true,
                  "legendFormat": "__auto",
                  "range": false
                }
              },
              "refId": "RAM Usage %",
              "hidden": false
            }
          },
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "prometheus",
                "datasource": {
                  "name": "cfywtrivkf0g0f"
                },
                "spec": {
                  "editorMode": "code",
                  "expr": "(1 - avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * 100",
                  "format": "table",
                  "instant": true,
                  "legendFormat": "__auto",
                  "range": false
                }
              },
              "refId": "CPU Load %",
              "hidden": false
            }
          },
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "prometheus",
                "datasource": {
                  "name": "cfywtrivkf0g0f"
                },
                "spec": {
                  "editorMode": "code",
                  "expr": "((sum by(instance) (node_filesystem_size_bytes{mountpoint=\"/\"}) - sum by(instance) (node_filesystem_free_bytes{mountpoint=\"/\"})) / sum by(instance) (node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
                  "format": "table",
                  "instant": true,
                  "legendFormat": "__auto",
                  "range": false
                }
              },
              "refId": "Disk Usage %",
              "hidden": false
            }
          },
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "prometheus",
                "datasource": {
                  "name": "cfywtrivkf0g0f"
                },
                "spec": {
                  "editorMode": "code",
                  "expr": "count by(instance) (node_cpu_seconds_total{mode=\"idle\"})",
                  "format": "table",
                  "instant": true,
                  "legendFormat": "__auto",
                  "range": false
                }
              },
              "refId": "CPU Cores",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "joinByField",
            "spec": {
              "options": {
                "byField": "instance",
                "mode": "outer"
              }
            }
          },
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {
                  "Time": true,
                  "time": true
                },
                "indexByName": {
                  "Value #CPU Cores": 2,
                  "Value #CPU Load %": 3,
                  "Value #Disk Usage %": 5,
                  "Value #RAM Usage %": 4,
                  "Value #Status": 1,
                  "instance": 0
                },
                "renameByName": {
                  "Value #CPU Cores": "Cores",
                  "Value #CPU Load %": "CPU Load",
                  "Value #Disk Usage %": "Disk Usage",
                  "Value #RAM Usage %": "RAM",
                  "Value #Status": "Status",
                  "instance": "Node"
                }
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "table",
      "version": "13.2.2",
      "spec": {
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "sortBy": [
            {
              "desc": false,
              "displayName": "Status"
            }
          ]
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "footer": {
                "reducers": []
              },
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "thresholds": {
