{
  "kind": "Panel",
  "spec": {
    "id": 3,
    "title": "VM Uptime ",
    "description": "Shows UP/DOWN status of each server instance over time",
    "links": [],
    "transparent": true,
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "prometheus",
                "datasource": {
                  "name": "cfywtrivkf0g0f"
                },
                "spec": {
                  "editorMode": "code",
                  "expr": "max by (instance) (up{platform=~\"vm|cloud_vm\"})",
                  "legendFormat": "{{instance}}",
                  "range": true
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "state-timeline",
      "version": "13.2.2",
      "spec": {
        "options": {
          "mergeValues": true,
          "showValue": "never",
          "alignValue": "left",
          "rowHeight": 0.7,
          "legend": {
            "showLegend": false,
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none",
            "hideZeros": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 0,
              "fillOpacity": 80,
              "spanNulls": false,
              "insertNulls": false,
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "axisPlacement": "auto"
            },
            "color": {
              "mode": "thresholds"
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DOWN",
                    "color": "red",
                    "index": 0
                  },
                  "1": {
                    "text": "UP",
                    "color": "green",
                    "index": 1
                  }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 1,
                  "color": "green"
                }
              ]
            },
            "unit": "none",
            "min": 0,
            "max": 1
          },
          "overrides": []
        }
      }
    }
  }
}